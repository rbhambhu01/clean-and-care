# Firebase config — all safe to be public (security lives in Firestore
# Security Rules, not in hiding these). Get these from:
# Firebase console -> Project settings -> General -> Your apps -> Web app
# or: firebase apps:sdkconfig WEB <appId> --project clean-and-care-laundry
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (offer banner image upload) — cloud name is public/safe.
# Unsigned upload preset name is also not secret by design, but keep it
# somewhat unguessable since it's the only gate on who can upload.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
