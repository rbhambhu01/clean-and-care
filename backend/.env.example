PORT=4000
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Comma-separated list of allowed frontend origins (no trailing slash, no path).
# Add your GitHub Pages origin once deployed, e.g.:
# CLIENT_ORIGIN=http://localhost:5173,https://rbhambhu01.github.io
CLIENT_ORIGIN=http://localhost:5173

# Offer banner image uploads (admin dashboard) go to Cloudinary's free tier.
# From your Cloudinary dashboard (https://cloudinary.com/console) homepage —
# all three are shown right there after signup, no extra clicks needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
